<UserControl x:Class="Any2GSX.UI.Views.Automation.ControlGsxServices"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Any2GSX.UI.Views.Automation"
             d:DataContext="{d:DesignInstance Type=local:ModelAutomation}"
             mc:Ignorable="d" 
             d:DesignHeight="1024" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../StyleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Column="0" Grid.Row="0" Margin="8,0,8,8" Style="{StaticResource GroupBoxDefault}" ToolTip="Configure which GSX Services are called by Any2GSX and when they are called.">
            <GroupBox.Header>Service Calls</GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox Grid.Column="0" Grid.Row="0" IsChecked="{Binding CallReposition}" Margin="6,8,6,6" Style="{StaticResource CheckBoxSettingItem}"
                          ToolTip="Automatically Reposition the Aircraft via GSX Menu on Session Start.&#x0a;Note: Do NOT use both the GSX Setting and this Option to Reposition the Plane at the same Time!">
                    <TextBlock><Underline>Reposition</Underline> Aircaft on Session Start</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="1" IsChecked="{Binding SkipFuelOnTankering}" Style="{StaticResource CheckBoxSettingItem}"
                      ToolTip="Do not call and ignore GSX Refuel Service if the Fuel on Board is already equal or higher than the planned Fuel Value.">
                    <TextBlock><Underline>Skip Refuel</Underline> Service-Call when FOB is higher than planned (for Tankering)</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="2" IsChecked="{Binding CallDeboardOnArrival}" Style="{StaticResource CheckBoxSettingItem}"
                          ToolTip="Automatically call Deboard when arrived at the Gate (Brake set, Engines off, Beacon off).&#x0a;GSX will call the Jetway and/or Stairs by itself when Deboarding is requested.">
                    <TextBlock>Call Deboard on <Underline>Arrival</Underline> (after Engines &amp; Beacon off)</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="3" IsChecked="{Binding RunDepartureOnArrival}" Style="{StaticResource CheckBoxSettingItem}"
                          ToolTip="Already start the Departure Services while Deboarding is active.&#x0a;Publish a new SimBrief OFP and ensure the Aircraft is in the Ready for Departure State (depends on Profile/Plugin - by default Power connected and Nav Lights on).&#x0a;Note: GSX does not allow certain Services to be active at the same Time (i.e. Cleaning and Deboarding).">
                    <TextBlock>Start <Underline>Departure</Underline> Services while <Underline>Deboarding</Underline> is active</TextBlock>
                </CheckBox>

                <StackPanel Grid.Column="0" Grid.Row="4" Style="{StaticResource SettingItemPanel}" Margin="6,4,6,6" ToolTip="When the SmartButton is used to call the next Service in the Queue, the last Service called is canceled.">
                    <TextBlock Style="{StaticResource TextBlockDefault}">
                        <Underline>Cancel</Underline> last Service on SmartButton Request:
                    </TextBlock>
                    <ComboBox SelectedValue="{Binding SmartButtonAbortService}" DisplayMemberPath="Value" ItemsSource="{Binding AbortOptions}" SelectedValuePath="Key" Margin="8,0,0,0" Style="{StaticResource ComboBoxDefault}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="0" Grid.Row="1" Style="{StaticResource GroupBoxDefault}" ToolTip="Configure which GSX Services are called by Any2GSX and when they are called.">
            <GroupBox.Header>Service Queue</GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Name="LabelQueueInUse" Style="{StaticResource TextBlockDefault}" Margin="6,8,0,0" Visibility="Collapsed">
                    <Italic>
                        <Bold>Note:</Bold> The Service Queue is currently in use. Some Changes (i.e. Order) may not apply until the next Departure Phase.
                    </Italic>
                </TextBlock>
                <TextBlock Grid.Column="0" Grid.Row="0" Name="LabelExternalControl" Style="{StaticResource TextBlockDefault}" Margin="6,8,0,0" Visibility="Collapsed">
                    <Italic>
                        <Bold>Note:</Bold> External Service Control is activated - Service Calls &amp; Order are handled through an external Application.
                    </Italic>
                </TextBlock>
                
                <ListBox Grid.Column="0" Grid.Row="1" Name="ListDepartureServices" Margin="0" ItemsSource="{Binding DepartureServices}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                    ToolTip="Departure Service Queue: GSX Services and the Rules if and when they are called in the Departure Phase.&#x0a;Click on a Service to configure!" MaxHeight="384">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="MinWidth" Value="808"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"
                                                Padding="2" Margin="0,2,0,2" SnapsToDevicePixels="true"> 
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorLight1BrushKey}}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="False">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BBBBBB"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border ToolTip="{Binding ServiceType}">
                                <Grid ToolTip="{Binding ServiceType}">
                                    <Grid x:Name="CollapsedView" HorizontalAlignment="Stretch" Visibility="Visible" ToolTip="{Binding ServiceType}">
                                        <Grid.Resources>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Orientation" Value="Horizontal"/>
                                                <Setter Property="Margin" Value="0,0,0,0"/>
                                            </Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockDefault}">
                                                <Setter Property="Margin" Value="4,2,4,2"/>
                                            </Style>
                                        </Grid.Resources>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" MinHeight="28"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ServiceType -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2" HorizontalAlignment="Left">
                                            <Image Source="../../Icons/caret-right.png" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ServiceType}" VerticalAlignment="Center" FontSize="12" FontWeight="DemiBold" MinWidth="64" ToolTip="{Binding ServiceType}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServiceActivationName}" TextDecorations="Underline" MinWidth="160"/>

                                        <StackPanel Grid.Row="0" Grid.Column="2" Visibility="{Binding HasActivation, Converter={StaticResource BoolVisibilityConverter}}">
                                            <TextBlock Text="{Binding ActivationText}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="3" Visibility="{Binding HasAnyConstraint, Converter={StaticResource BoolVisibilityConverter}}">
                                            <TextBlock Text="{Binding ConstraintText}" FontWeight="Light"/>
                                        </StackPanel>
                                    </Grid>


                                    <Grid x:Name="ExpandedView" HorizontalAlignment="Stretch" Visibility="Collapsed" ToolTip="{Binding ServiceType}">
                                        <Grid.Resources>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Orientation" Value="Horizontal"/>
                                                <Setter Property="Margin" Value="0,0,0,0"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockDefault}">
                                                <Setter Property="Margin" Value="4,2,4,2"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxDefault}">
                                                <Setter Property="Margin" Value="2,2,2,2"/>
                                                <Setter Property="Padding" Value="6,3,24,4"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxSettingItem}">
                                                <Setter Property="Margin" Value="2,2,2,2"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxLeft}">
                                                <Setter Property="Margin" Value="2,2,2,2"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </Grid.Resources>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ServiceType -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,4,4,2" MouseDown="OnServiceMouseDown">
                                            <Image Source="../../Icons/caret-down.png" Width="14" Height="14"/>
                                            <TextBlock Text="{Binding ServiceType}" FontSize="12" FontWeight="DemiBold" MinWidth="64" ToolTip="{Binding ServiceType}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                                            <Button Name="ButtonUp" Style="{StaticResource BtnSquareSmall}"
                                                    Command="{Binding CommandButtonUp}" CommandParameter="{Binding SelectedIndex, ElementName=ListDepartureServices}"
                                                    ToolTip="Move Service Up in the Queue.">
                                                <Image Source="../../Icons/chevron-up.png" Style="{StaticResource ImgSquareSmall}"/>
                                            </Button>
                                            <Button Name="ButtonDown" Margin="0,6,0,6" Style="{StaticResource BtnSquareSmall}"
                                                    Command="{Binding CommandButtonDown}" CommandParameter="{Binding SelectedIndex, ElementName=ListDepartureServices}"
                                                    ToolTip="Move Service Down in the Queue.">
                                                <Image Source="../../Icons/chevron-down.png" Style="{StaticResource ImgSquareSmall}"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- ACTIVATION -->
                                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="4,4,4,4">
                                            <Underline>Activate Service</Underline>:
                                        </TextBlock>
                                        <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding DataContext.TextServiceActivations, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                                    SelectedValue="{Binding ServiceActivation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    MinWidth="184">
                                            <ComboBox.ToolTip>
                                                <TextBlock>
                                                    Select if and how the Service is activated:<LineBreak />
                                                    - Never: The Service is neither called by the App nor is it monitored.<LineBreak />
                                                    - Manual: The Service is called externally by the User or another Addon but is monitored to be completed!<LineBreak />
                                                    - Independent: The Service is called by the App directly without any prerequisites (if the Constraints allow).<LineBreak />
                                                    - Time to Departure: The Service is called by the App based on the Departure Time (from Simbrief, compared to either Sim Time or System Time).<LineBreak />
                                                    - Dependent on Services: The Service is called by the App based on the State of other Services.
                                                </TextBlock>
                                            </ComboBox.ToolTip>
                                        </ComboBox>


                                        <!-- Service Dependency -->
                                        <StackPanel Grid.Row="0" Grid.Column="3" Visibility="{Binding HasDependency, Converter={StaticResource BoolVisibilityConverter}}">
                                            <TextBlock>
                                                Based on
                                            </TextBlock>
                                            <ComboBox ItemsSource="{Binding DataContext.TextServiceDependencyScope, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Value" SelectedValuePath="Key"                                                  
                                                      SelectedValue="{Binding ServiceDependencyScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      MinWidth="124">
                                                <ComboBox.ToolTip>
                                                    <TextBlock>
                                                        Select which other Services' State(s) are checked:<LineBreak />
                                                        - Last called: The last Service that was called by the App (so not bound to the Order in the Queue).<LineBreak />
                                                        - All called: All Services that were called by the App so far.<LineBreak />
                                                        - Previous queued: The previous Service in the Queue (so bound to the Order in the Queue)<LineBreak />
                                                        - All queued: All previous Services in the Queue.<LineBreak /><LineBreak />
                                                        Note: The first Service is always called regardless. Skipped Services are not checked.
                                                    </TextBlock>
                                                </ComboBox.ToolTip>
                                            </ComboBox>
                                            <TextBlock>
                                                Service(s) at least in State
                                            </TextBlock>
                                            <ComboBox ItemsSource="{Binding DataContext.TextServiceDependencies, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Value" SelectedValuePath="Key"                                                  
                                                      SelectedValue="{Binding ServiceDependency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      MinWidth="96">
                                                <ComboBox.ToolTip>
                                                    <TextBlock>
                                                        The minimum State of the Service(s):<LineBreak />
                                                        - Requested: the Service Vehicle is on the Way or the Service is waiting to become active.<LineBreak />
                                                        - Active: the Service is actively being performed.<LineBreak />
                                                        - Completed: the Service was completed (or cancelled gracefully).
                                                    </TextBlock>
                                                </ComboBox.ToolTip>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Depart Time -->
                                        <StackPanel Grid.Row="0" Grid.Column="3" Visibility="{Binding HasDepartureTime, Converter={StaticResource BoolVisibilityConverter}}"
                                                    ToolTip="The Time in Minutes to check against the SimBrief Departure Time.&#x0a;Per default checked agains the Simulator Time, but the App can be configured to use the System Time.">
                                            <TextBlock>
                                                is lower than
                                            </TextBlock>
                                            <TextBox Text="{Binding MaxTimeBeforeDeparture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding HasDepartureTime, Converter={StaticResource BoolVisibilityConverter}}"
                                                     HorizontalContentAlignment="Center" MinWidth="64"/>
                                            <TextBlock>
                                                <Italic>minutes</Italic>
                                            </TextBlock>
                                        </StackPanel>


                                        <!-- CANCELLATION -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                                   Visibility="{Binding HasActivation, Converter={StaticResource BoolVisibilityConverter}}">
                                            <Underline>Cancellation</Underline>:
                                        </TextBlock>
                                        <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding DataContext.TextServiceCancellations, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                                  Visibility="{Binding HasActivation, Converter={StaticResource BoolVisibilityConverter}}"
                                                  SelectedValue="{Binding ServiceCancellation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="184">
                                            <ComboBox.ToolTip>
                                                <TextBlock>
                                                    Select if and how the Service is cancelled:<LineBreak />
                                                    - Never: The Service is not cancelled by the App.<LineBreak />
                                                    - Max Run Time: The Service is cancelled by the App if it runs longer than the configured Time.<LineBreak />
                                                    - Dependent on Services: The Service is cancelled by the App based on the State of other Services (when at least in the Active State).
                                                </TextBlock>
                                            </ComboBox.ToolTip>
                                        </ComboBox>


                                        <!-- Service Dependency -->
                                        <StackPanel Grid.Row="1" Grid.Column="3" Visibility="{Binding HasCancelDependency, Converter={StaticResource BoolVisibilityConverter}}">
                                            <TextBlock>
                                                Based on
                                            </TextBlock>
                                            <ComboBox ItemsSource="{Binding DataContext.TextServiceDependencyScope, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Value" SelectedValuePath="Key"                                                  
                                                      SelectedValue="{Binding ServiceCancelDependencyScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="124">
                                                <ComboBox.ToolTip>
                                                    <TextBlock>
                                                        Select which other Services' State(s) are checked:<LineBreak />
                                                        - Last called: The last Service that was called by the App (so not bound to the Order in the Queue).<LineBreak />
                                                        - All called: All Services that were called by the App so far.<LineBreak />
                                                        - Previous queued: The previous Service in the Queue (so bound to the Order in the Queue)<LineBreak />
                                                        - All queued: All previous Services in the Queue.
                                                    </TextBlock>
                                                </ComboBox.ToolTip>
                                            </ComboBox>
                                            <TextBlock>
                                                Service(s) at least in State
                                            </TextBlock>
                                            <ComboBox ItemsSource="{Binding DataContext.TextServiceDependencies, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Value" SelectedValuePath="Key"  
                                                        Visibility="{Binding HasCancelDependency, Converter={StaticResource BoolVisibilityConverter}}"
                                                        SelectedValue="{Binding ServiceCancelDependency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="96">
                                                <ComboBox.ToolTip>
                                                    <TextBlock>
                                                        The minimum State of the Service(s):<LineBreak />
                                                        - Requested: the Service Vehicle is on the Way or the Service is waiting to become active.<LineBreak />
                                                        - Active: the Service is actively being performed.<LineBreak />
                                                        - Completed: the Service was completed (or cancelled gracefully).
                                                    </TextBlock>
                                                </ComboBox.ToolTip>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Max Run Time -->
                                        <StackPanel Grid.Row="1" Grid.Column="3" Visibility="{Binding HasMaxRunTime, Converter={StaticResource BoolVisibilityConverter}}"
                                                    ToolTip="The Maximum Amount of Time in Minutes the Service allowed to run (after it became Active).">
                                            <TextBlock>
                                                is not more than
                                            </TextBlock>
                                            <TextBox Text="{Binding MaxRunTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalContentAlignment="Center" MinWidth="64"/>
                                            <TextBlock>
                                                <Italic>minutes</Italic>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        

                                        <!-- CONSTRAINTS -->
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Visibility="{Binding HasActivation, Converter={StaticResource BoolVisibilityConverter}}">
                                            <Underline>Constraints</Underline>:
                                        </TextBlock>
                                        <Grid Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                              Visibility="{Binding HasActivation, Converter={StaticResource BoolVisibilityConverter}}">
                                            <Grid.Resources>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Orientation" Value="Horizontal"/>
                                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                                </Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockDefault}">
                                                    <Setter Property="Margin" Value="4,2,4,2"/>
                                                </Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxSettingItem}">
                                                    <Setter Property="Margin" Value="2,2,8,2"/>
                                                </Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxLeft}">
                                                    <Setter Property="Margin" Value="2,2,2,2"/>
                                                </Style>
                                            </Grid.Resources>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding OnlyDeparture, Mode=TwoWay}"
                                                      ToolTip="Only call the Service on the first Leg.">
                                                Leg: Only on Departure
                                            </CheckBox>
                                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding OnlyHub, Mode=TwoWay}"
                                                      ToolTip="Only call the Service on Airports matching the configured Company Hubs.">
                                                Company: Only on Hub Airport
                                            </CheckBox>
                                            <CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding OnlyOnPax, Mode=TwoWay}"
                                                      ToolTip="Only call the Service on Passenger Flights (so not on Cargo Aircrafts).">
                                                Aircraft: Only for Pax
                                            </CheckBox>

                                            
                                            <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding OnlyTurn, Mode=TwoWay}"
                                                      ToolTip="Only call the Service in a Turnaround.">
                                                Leg: Only on Turnaround
                                            </CheckBox>
                                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding OnlyNonHub, Mode=TwoWay}"
                                                      ToolTip="Only call the Service on Airports not matching the configured Company Hubs.">
                                                Company: Only on Non-Hub Airport
                                            </CheckBox>
                                            <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding OnlyPreferredOp, Mode=TwoWay}"
                                                      ToolTip="Only call the Service when one the preferred Handling Operators was selected.">
                                                Operator: Preferred selected
                                            </CheckBox>


                                            <StackPanel Grid.Row="2" Grid.Column="0" ToolTip="Only call the Service when the Flight Time is greater or equal to the configured Duration.">
                                                <TextBlock>
                                                    Min. Flight Time
                                                </TextBlock>
                                                <TextBox Text="{Binding MinimumFlightDuration, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         HorizontalContentAlignment="Center" MinWidth="64"/>
                                                <TextBlock FontWeight="Light">
                                                    <Italic>hh:mm</Italic>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Visibility="{Binding HasCancelDependency, Converter={StaticResource BoolVisibilityConverter}}"
                                                        ToolTip="Minimum Time the Service needs to be in the Active State before it is cancelled.">
                                                <TextBlock>
                                                    Min. Run Time:
                                                </TextBlock>
                                                <TextBox Text="{Binding MinRunTime, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         HorizontalContentAlignment="Center" MinWidth="64"/>
                                                <TextBlock FontWeight="Light">
                                                    <Italic>minutes</Italic>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2" ToolTip="Delay the Service Call x Seconds after the last called Service.">
                                                <TextBlock>
                                                    Call Delay
                                                </TextBlock>
                                                <TextBox Text="{Binding CallDelay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalContentAlignment="Center" MinWidth="64"/>
                                                <TextBlock FontWeight="Light">
                                                    <Italic>seconds</Italic>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="CollapsedView" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="ExpandedView" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Column="0" Grid.Row="2" Name="ButtonResetQueue" Command="{Binding ResetQueueCommand}"
                        Style="{StaticResource BtnDefault}" Foreground="OrangeRed" FontWeight="DemiBold" Padding="6,2,6,2" MinHeight="24" Margin="2,6,0,1" HorizontalAlignment="Left" Visibility="Visible"
                        ToolTip="Reset Service Queue to default Settings">
                    Reset Queue
                </Button>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="0" Grid.Row="2" Style="{StaticResource GroupBoxDefault}">
            <GroupBox.Header>Pushback &amp; Tug</GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Margin="6,8,6,6" Style="{StaticResource SettingItemPanel}" ToolTip="Automatically call Pushback after all Departure Services have finished - in Case the Tug was already attached during Boarding.">
                    <TextBlock Style="{StaticResource TextBlockDefault}">
                        Call for Pushback when <Underline>Tug was attached</Underline> during Boarding:
                    </TextBlock>
                    <ComboBox SelectedValue="{Binding CallPushbackWhenTugAttached}" SelectedValuePath="Tag" Margin="8,0,0,0" Style="{StaticResource ComboBoxDefault}">
                        <ComboBoxItem Tag="0">Never</ComboBoxItem>
                        <ComboBoxItem Tag="1">Services completed</ComboBoxItem>
                        <ComboBoxItem Tag="2">Final transmitted</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <CheckBox Grid.Column="0" Grid.Row="1" IsChecked="{Binding CallPushbackOnBeacon}" Style="{StaticResource CheckBoxSettingItem}"
                          ToolTip="Automatically call Pushback when the Beacon is turned on (AND Brake set &amp; Power disconnected).">
                    <TextBlock>Call for Pushback when <Underline>Beacon</Underline> is turned on</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="2" IsChecked="{Binding CallPushbackOnFinal}" Style="{StaticResource CheckBoxSettingItem}"
                          ToolTip="Automatically call Pushback when the Final LS is received (time is expired).&#x0a;This Option is independent from the above - so Pushback is called regardless if the Tug was attached during Boarding.">
                    <TextBlock>Call for Pushback when <Underline>Final LS</Underline> is received</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="3" IsChecked="{Binding CancelServicesOnPushPhase}" Style="{StaticResource CheckBoxSettingItem}"
                          ToolTip="When Any2GSX is in the Pushback Phase, all running Departure Services will be canceled.&#x0a;The Option is meant to handle non-normal Situations where Services still run in this Phase (normally they are all completed).">
                    <TextBlock><Underline>Cancel all</Underline> Departure Services in the Pushback Phase</TextBlock>
                </CheckBox>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
