<UserControl x:Class="Any2GSX.UI.Views.Automation.ControlBriefing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Any2GSX.UI.Views.Automation"
             d:DataContext="{d:DesignInstance Type=local:ModelBriefing}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../StyleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Stretch" Margin="0,0,0,2" Width="526">
        <Grid.Resources>
            <Style x:Key="Grid" TargetType="Grid">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="4,2,4,2" />
            </Style>
            <Style x:Key="StackPanel" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="4,2,4,2" />
            </Style>
            <Style x:Key="StackPanelVert" TargetType="StackPanel" BasedOn="{StaticResource StackPanel}">
                <Setter Property="Orientation" Value="Vertical"/>
                <Setter Property="Margin" Value="0,2,32,2" />
            </Style>
            <Style x:Key="Text" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="MinHeight" Value="22"/>
                <Setter Property="Padding" Value="4,2,4,2" />
            </Style>
            
            <Style x:Key="GridHeader" TargetType="Grid">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="4,2,4,2" />
                <Setter Property="Background" Value="LightGray"/>
            </Style>
            <Style x:Key="TextHeader" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Padding" Value="4,2,12,2"/>
            </Style>


            <Style x:Key="TextGroup" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="4,12,4,2" />
            </Style>
            <Style x:Key="BorderGroup" TargetType="Border">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="BorderBrush" Value="Black"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="Margin" Value="4,2,4,2" />
            </Style>

            <Style x:Key="TextLabel" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="FontWeight" Value="DemiBold"/>
            </Style>
            <Style x:Key="TextRight" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Visibility="{Binding IsFlightplanLoaded, Converter={StaticResource BoolVisibilityInverseConverter}}" Style="{StaticResource TextHeader}" Background="LightGray" Margin="4,2,4,2">
            NO OFP IMPORTED
        </TextBlock>
        <Grid Grid.Row="0" Style="{StaticResource GridHeader}" Visibility="{Binding IsFlightplanLoaded, Converter={StaticResource BoolVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource TextHeader}" Text="{Binding OfpId}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TextHeader}" Text="{Binding Date}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource TextHeader}" Text="{Binding FlightNumber}"/>
            <TextBlock Grid.Column="3" Style="{StaticResource TextHeader}" Text="{Binding Leg}"/>
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource StackPanel}">
            <StackPanel Style="{StaticResource StackPanelVert}" ToolTip="ATC Call Sign filed in Simbrief">
                <TextBlock Style="{StaticResource TextLabel}">
                    ATC CS
                </TextBlock>
                <TextBlock Style="{StaticResource Text}" Text="{Binding CallSign}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource StackPanelVert}" ToolTip="Aircraft Registration filed in Simbrief">
                <TextBlock Style="{StaticResource TextLabel}">
                    AC REG
                </TextBlock>
                <TextBlock Style="{StaticResource Text}" Text="{Binding AircraftReg}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource StackPanelVert}" ToolTip="Aircraft ICAO Type filed in Simbrief">                
                <TextBlock Style="{StaticResource TextLabel}">
                    TYPE
                </TextBlock>
                <TextBlock Style="{StaticResource Text}" Text="{Binding AircraftType}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource StackPanelVert}" ToolTip="Scheduled Departure/Out Time in UTC (as imported by SimBrief or set by external App or Plugin)">
                <TextBlock Style="{StaticResource TextLabel}">
                    OUT
                </TextBlock>
                <TextBlock Style="{StaticResource Text}" Text="{Binding SchedOut}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource StackPanelVert}" ToolTip="Time to Departure used for Service Calls (as seen by the App - per default using the Sim Time)">
                <TextBlock Style="{StaticResource TextLabel}">
                    TTD
                </TextBlock>
                <TextBlock Style="{StaticResource Text}" Text="{Binding TimeToDepart}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource StackPanelVert}">
                <StackPanel.ToolTip>
                    <TextBlock>
                        Flight State based on App Phase:<LineBreak />
                        - NOT AVAIL - Session not initialized or App Phase in Session Start.<LineBreak />
                        - NO INIT - Waiting for OFP Import in Preparation or Turn Around Phase.<LineBreak />
                        - GND HANDLING - Aircraft is being serviced in Departure or Arrival Phase.<LineBreak />
                        - TAXI - Aircraft / App in Taxi-Out or Taxi-In Phase.<LineBreak />
                        - PUSH - Aircraft / App in Pushback Phase.<LineBreak />
                        - FLIGHT - Aircraft / App in Flight Phase.
                    </TextBlock>
                </StackPanel.ToolTip>
                <TextBlock Style="{StaticResource TextLabel}">
                    STATE
                </TextBlock>
                <TextBlock Style="{StaticResource Text}" Text="{Binding State}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource BorderGroup}">
            <TextBlock Style="{StaticResource TextGroup}">
                WEIGHTS
            </TextBlock>
        </Border>
        <Grid Grid.Row="3" Grid.Column="0" VerticalAlignment="Stretch" Margin="4,2,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="112"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextLabel}" ToolTip="Count of planned Passenger and Bags">
                PAX / BAGS
            </TextBlock>
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TextRight}" Text="{Binding PaxBag}" ToolTip="Count of planned Passenger and Bags"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TextLabel}" ToolTip="Sum of Pax and Cargo Total Weight (actual Pax/Bag Count)">
                PAYLOAD
            </TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TextRight}" Text="{Binding Payload}" ToolTip="Sum of Pax and Cargo Total Weight (actual Pax/Bag Count)"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource TextLabel}" ToolTip="Fuel Target used by the App">
                FUEL
            </TextBlock>
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TextRight}" Text="{Binding Fuel}" ToolTip="Fuel Target used by the App"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource TextLabel}" ToolTip="Empty Operating Weight as imported from Simbrief">
                OEW
            </TextBlock>
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource TextRight}" Text="{Binding Empty}" ToolTip="Empty Operating Weight as imported from Simbrief"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource TextLabel}" ToolTip="Zero Fuel Weight with actual Pax/Bag Count">
                ZFW
            </TextBlock>
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource TextRight}" Text="{Binding ZeroFuel}" ToolTip="Zero Fuel Weight with actual Pax/Bag Count"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource TextLabel}" ToolTip="Aircraft Gross Weight at the Ramp with actual Pax/Bag Count">
                GW
            </TextBlock>
            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource TextRight}" Text="{Binding WeightTotal}" ToolTip="Aircraft Gross Weight at the Ramp with actual Pax/Bag Count"/>
            

            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource TextLabel}" ToolTip="Difference applied to planned Pax/Bag Count">
                DIFF
            </TextBlock>
            <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource TextRight}" Text="{Binding PaxBagDiff}" ToolTip="Difference applied to planned Pax/Bag Count"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource TextLabel}" ToolTip="Actual total Weight of Passengers">
                PAX WEIGHT
            </TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource TextRight}" Text="{Binding WeightPax}" ToolTip="Actual total Weight of Passengers"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource TextLabel}" ToolTip="Actual total Weight of Bags">
                BAG WEIGHT
            </TextBlock>
            <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource TextRight}" Text="{Binding WeightBag}" ToolTip="Actual total Weight of Bags"/>
            <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource TextLabel}" ToolTip="Additional Freight for the Cargo Hold">
                FREIGHT
            </TextBlock>
            <TextBlock Grid.Row="3" Grid.Column="4" Style="{StaticResource TextRight}" Text="{Binding Freight}" ToolTip="Additional Freight for the Cargo Hold"/>
            <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource TextLabel}" ToolTip="Total Weight for the Cargo Hold (Freight + actual Bag Weight)">
                CARGO TOTAL
            </TextBlock>
            <TextBlock Grid.Row="4" Grid.Column="4" Style="{StaticResource TextRight}" Text="{Binding Cargo}" ToolTip="Total Weight for the Cargo Hold (Freight + actual Bag Weight)"/>
            <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource TextLabel}" ToolTip="Difference to planned GW due to actual Pax/Bag Count">
                DIFF PLN
            </TextBlock>
            <TextBlock Grid.Row="5" Grid.Column="4" Style="{StaticResource TextRight}" Text="{Binding PayloadDiff}" ToolTip="Difference to planned GW due to actual Pax/Bag Count"/>
        </Grid>


        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource BorderGroup}">
            <TextBlock Style="{StaticResource TextGroup}">
                GROUND HANDLING
            </TextBlock>
        </Border>
        <Grid Grid.Row="5" Grid.Column="0" VerticalAlignment="Stretch" Margin="4,2,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextLabel}" ToolTip="The Agent/Provider controlling and calling the Ground Services.&#x0a;By default the App itself (A2G) using the configured Departure Queue -or- an external App controlling the Services.&#x0a;If controlled externally either EXT or the Name provided by the external App.">
                AGENT
            </TextBlock>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding QueueHandler}" Style="{StaticResource Text}" ToolTip="The Agent/Provider controlling and calling the Ground Services.&#x0a;By default the App itself (A2G) using the configured Departure Queue -or- an external App controlling the Services.&#x0a;If controlled externally either EXT or the Name provided by the external App."/>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TextLabel}" ToolTip="The current/active Gate (uiGateName) as reported by GSX">
                PARKING
            </TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveGate}" Style="{StaticResource Text}" ToolTip="The current/active Gate (uiGateName) as reported by GSX"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource TextLabel}" ToolTip="Queued/Available Services to be called">
                SERVICES
            </TextBlock>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QueuedServices}" Style="{StaticResource Text}" ToolTip="Queued/Available Services to be called"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource TextLabel}" ToolTip="The available Pushback Directions as reported by GSX for the current/active Gate.&#x0a;When a Direction is pre-selected any Time before GSX asks for it, the App will automatically select that Direction.&#x0a;The Menu/Toolbar will not be enabled when a Direction is selected - unless Icing Conditons exist.&#x0a;User Selection is disabled when the App is controlled externally.">
                PUSH DIR
            </TextBlock>
            <ComboBox Grid.Row="3" Grid.Column="1" Name="ComboboxPushDirection" ItemsSource="{Binding PushbackDirections}" SelectedValue="{Binding SelectedPushDirection}" SelectedIndex="0" IsEnabled="{Binding IsPushSelectable}"
                      Style="{StaticResource ComboBoxDefault}" FontFamily="Consolas" FontSize="14" Margin="0,2,4,2" Padding="5,3,24,3"
                      ToolTip="The available Pushback Directions as reported by GSX for the current/active Gate.&#x0a;When a Direction is pre-selected any Time before GSX asks for it, the App will automatically select that Direction.&#x0a;The Menu/Toolbar will not be enabled when a Direction is selected - unless Icing Conditons exist.&#x0a;User Selection is disabled when the App is controlled externally."/>

            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource TextLabel}" ToolTip="Enter or select an Arrival Gate to be automatically selected in the Taxi-In Phase.&#x0a;When entering a Text it will be used to search the Menu (via API, no Key Inputs) - exactly one Result is expected, else the Selection will fail.&#x0a;Selection over all Gates is only available at the Destination (Taxi-In Phase) and can be filtered by the Text Box.">
                GATE DEST
            </TextBlock>
            <Grid Grid.Row="4" Grid.Column="1" ToolTip="Enter or select an Arrival Gate to be automatically selected in the Taxi-In Phase.&#x0a;When entering a Text it will be used to search the Menu (via API, no Key Inputs) - exactly one Result is expected, else the Selection will fail.&#x0a;Selection over all Gates is only available at the Destination (Taxi-In Phase) and can be filtered by the Text Box.">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Name="TextGate" Text="{Binding AssignedArrivalGate}" Style="{StaticResource Text}" Margin="1,2,0,2" Visibility="Visible"/>
                <TextBox Grid.Column="0" Grid.Row="0" Name="InputGate" Style="{StaticResource TextBoxLeft}" Margin="0,2,4,2" Padding="0,0,0,1" MinHeight="24" Visibility="Collapsed" FontFamily="Consolas" HorizontalAlignment="Stretch"/>
                <Button Grid.Column="1" Grid.Row="0" Click="OnGateSearchClicked" Style="{StaticResource BtnSquareSmall}" Margin="0,0,4,0" IsEnabled="{Binding IsGateSelectable}">
                    <Image Source="../../Icons/search.png" Style="{StaticResource ImgSquareSmall}"/>
                </Button>                
            </Grid>

            <ListView Grid.Row="5" Grid.Column="1" Name="ListGates" ItemsSource="{Binding GatesFiltered}" VerticalAlignment="Center" VerticalContentAlignment="Center" FontFamily="Consolas" Margin="0,2,4,2"
                      Visibility="Collapsed" SelectionMode="Single" SelectedIndex="-1" MaxHeight="192" MinHeight="96">
            </ListView>
        </Grid>
    </Grid>
</UserControl>
