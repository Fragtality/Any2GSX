<UserControl x:Class="Any2GSX.UI.Views.Automation.ControlGateDoors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Any2GSX.UI.Views.Automation"
             d:DataContext="{d:DesignInstance Type=local:ModelAutomation}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../StyleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Column="0" Grid.Row="0" Margin="8,0,8,8" Style="{StaticResource GroupBoxDefault}">
            <GroupBox.Header>Door Handling</GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Margin="4,0,0,6" Visibility="{Binding PluginCapabilities.HasDoorSync, Converter={StaticResource BoolVisibilityInverseConverter}}">
                    <Italic>
                        <Bold>Note:</Bold> These Settings are only available to Aircraft Plugins implementing Door-Sync.
                    </Italic>
                </Label>

                <Label Grid.Column="0" Grid.Row="0" Margin="4,0,0,6" Visibility="{Binding PluginCapabilities.HasDoorSync, Converter={StaticResource BoolVisibilityConverter}}">
                    <Italic>
                        <Bold>Note:</Bold> Some of the Settings depend on what the Plugin has implemented for Door-Sync.
                    </Italic>
                </Label>

                <CheckBox Grid.Column="0" Grid.Row="1" IsChecked="{Binding CloseDoorsOnFinal}" Margin="6,6,6,6" Style="{StaticResource CheckBoxSettingItem}" 
                          ToolTip="Calls the 'DoorAllClose' Function of the Plugin (if it reports open Doors) after the Final Loadsheet Delay expired.&#x0a;The DoorAllClose Function should always close the Doors, regardless of the other Options.">
                    <TextBlock>Close all Doors when <Underline>Final Loadsheet</Underline> is transmitted</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="2" IsChecked="{Binding DoorPaxHandling}" Style="{StaticResource CheckBoxSettingItem}" 
                          ToolTip="Open and Close the Passenger Doors as required for GSX. Uncheck to disable automatic Handling of the Passenger Doors.">
                    <TextBlock>Operate <Underline>Passenger Doors</Underline> for GSX Services</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="3" IsChecked="{Binding DoorStairHandling}" IsEnabled="{Binding DoorPaxHandling}" Style="{StaticResource CheckBoxSettingItemIndented}" Visibility="{Binding PluginCapabilities.HasDoorSyncPaxStair, Converter={StaticResource BoolVisibilityConverter}}"
                          ToolTip="Open the Passenger Doors when the Stairs have finished moving and close the Doors as soon as they begin to move again.">
                    <TextBlock><Underline>Open / Close</Underline> Passenger Doors when GSX <Underline>Stairs</Underline> are connected / removed</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="4" IsChecked="{Binding DoorServiceHandling}" Style="{StaticResource CheckBoxSettingItem}" Visibility="{Binding PluginCapabilities.HasDoorSyncService, Converter={StaticResource BoolVisibilityConverter}}"
                          ToolTip="Open and Close the Service Doors as required for GSX. Uncheck to disable automatic Handling of the Service Doors.">
                    <TextBlock>Operate <Underline>Service Doors</Underline> for Catering</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="5" IsChecked="{Binding DoorCargoHandling}" Style="{StaticResource CheckBoxSettingItem}" 
                          ToolTip="Open and Close the Cargo Door as required for GSX. Uncheck to disable automatic Handling of the Cargo Doors.&#x0a;If supported by the Aircraft Plugin, the Cargo Doors will be operated based on Loaders attached or GSX sending a Trigger.">
                    <TextBlock>Operate <Underline>Cargo Doors</Underline> for Boarding &amp; Deboarding</TextBlock>
                </CheckBox>
                
                <StackPanel Grid.Column="0" Grid.Row="6" Style="{StaticResource SettingItemPanel}" Margin="22,0,0,0">
                    <CheckBox IsChecked="{Binding DoorCargoOpenOnActive}" IsEnabled="{Binding DoorCargoHandling}" Style="{StaticResource CheckBoxSettingItem}"
                              ToolTip="Open the Cargo Doors after the configured Delay when GSX Boarding/Deboarding Service is requested.&#x0a;Close the Cargo Doors after the configured Delay when the Service is completed.">
                        <TextBlock>Open / Close Doors on GSX <Underline>Service State</Underline> change. Delay:</TextBlock>
                    </CheckBox>
                    <TextBox Name="InputDelayCargoDoors" Style="{StaticResource TextBoxCentered}" ToolTip="Open the Cargo Doors after the configured Delay when GSX Boarding/Deboarding Service is requested.&#x0a;Close the Cargo Doors after the configured Delay when the Service is completed."/>
                    <TextBlock Margin="2,0,0,0" Style="{StaticResource TextBlockDefault}">s</TextBlock>
                </StackPanel>

                <CheckBox Grid.Column="0" Grid.Row="7" IsChecked="{Binding DoorCargoOperateBulk}" IsEnabled="{Binding DoorCargoOpenOnActive}" Style="{StaticResource CheckBoxSettingItemIndented}"
                          ToolTip="The Bulk Cargo Door is open or closed with the other Cargo Doors when the Service State changes.">
                    <TextBlock>Open / Close <Underline>Bulk Cargo</Underline> on Service State</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="8" IsChecked="{Binding DoorsCargoKeepOpenOnDetachBoard}" IsEnabled="{Binding DoorCargoHandling}" Style="{StaticResource CheckBoxSettingItemIndented}" Visibility="{Binding PluginCapabilities.HasDoorSyncCargo, Converter={StaticResource BoolVisibilityConverter}}"
                          ToolTip="Do not close the Cargo Doors when the GSX Cargo/Belt Loader is detached on Boarding.">
                    <TextBlock>Keep Cargo Doors <Underline>open after Boarding</Underline></TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="9" IsChecked="{Binding DoorsCargoKeepOpenOnDetachDeboard}" IsEnabled="{Binding DoorCargoHandling}" Style="{StaticResource CheckBoxSettingItemIndented}" Visibility="{Binding PluginCapabilities.HasDoorSyncCargo, Converter={StaticResource BoolVisibilityConverter}}"
                          ToolTip="Do not close the Cargo Doors when the GSX Cargo/Belt Loader is detached on Deboarding.">
                    <TextBlock>Keep Cargo Doors <Underline>open after Deboarding</Underline></TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="10" IsChecked="{Binding DoorPanelHandling}" Style="{StaticResource CheckBoxSettingItem}" Visibility="{Binding PluginCapabilities.HasPanelSync, Converter={StaticResource BoolVisibilityConverter}}"
                          ToolTip="Open and Close Service Panels on the Aircraft used for Refuel, Lavatory &amp; Water.">
                    <TextBlock>Operate <Underline>Service Panels</Underline> for Refuel, Lavatory &amp; Water</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="11" IsChecked="{Binding DoorPreferAirstair}" Style="{StaticResource CheckBoxSettingItem}" Visibility="{Binding PluginCapabilities.HasAirStairs, Converter={StaticResource BoolVisibilityConverter}}"
                          ToolTip="Use Airstairs over GSX Stairs: Airstairs are extended automatically by the App before the GSX Stairs are called (or retracted when removed). Requires correct Setup in the GSX Aircraft Profile!&#x0a;Applies to all Options which are concerned with connecting or removing Stairs.&#x0a;Note: Using Airstairs will always disable the Jetway - the App will skip the Jetway.">
                    <TextBlock>Use the <Underline>Airstairs</Underline> of the Aircraft instead of GSX Jetway/Stairs</TextBlock>
                </CheckBox>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="0" Grid.Row="1" Style="{StaticResource GroupBoxDefault}">
            <GroupBox.Header>Jetway &amp; Stair Control</GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox Grid.Column="0" Grid.Row="0" IsChecked="{Binding CallJetwayStairsInWalkaround}" Margin="6,8,6,6" Style="{StaticResource CheckBoxSettingItem}"
                    ToolTip="The Aircraft is already repositioned and GSX Jetway/Stairs are called while the Sim is still in the 'Ready to Fly' Screen or (intial) Walkaround Mode.&#x0a;This Behaviour works regardless if the Sim or App are configured to skip the Walkaround Mode.&#x0a;Note: The Jetway can only be triggered if Walkaround is NOT configured in the Sim!">
                    <TextBlock>Connect Jetway and Stairs in <Underline>Ready to Fly / Walkaround</Underline> Mode (including Reposition)</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="1" IsChecked="{Binding PreferCustomStairsInWalkaround}" Style="{StaticResource CheckBoxSettingItemIndented}" Visibility="{Binding PluginCapabilities.HasCustomStairs, Converter={StaticResource BoolVisibilityConverter}}"
                          ToolTip="The custom Stairs of the Aircraft are used instead of calling the GSX Stairs - only if Walkaround Mode is enabled in the Sim.&#x0a;The custom Stairs will only be used in the initial Walkaround, after that they will be removed as soon as GSX Jetway/Stairs are called.&#x0a;Note: When the Aircraft has both custom Stairs &amp; Airstairs, this Option wins over the Use Airstair Option above.">
                    <TextBlock>Use Aircraft <Underline>Custom Stairs</Underline> in Walkaround Mode</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="2" IsChecked="{Binding CallJetwayStairsOnPrep}" Style="{StaticResource CheckBoxSettingItem}"
                          ToolTip="Automatically call Jetway and/or Stairs (which ever is available) in the Preparation Phase.&#x0a;This Option gets only active after Ready to Fly Screen and Walkaround Mode.&#x0a;If not called automatically, you can use the Smart-Button to call the Jetway/Stairs in the Preparation Phase.">
                    <TextBlock>Connect Jetway and Stairs in <Underline>Preparation</Underline> Phase</TextBlock>
                </CheckBox>

                <CheckBox Grid.Column="0" Grid.Row="3" IsChecked="{Binding CallJetwayStairsDuringDeparture}" Style="{StaticResource CheckBoxSettingItem}"
                          ToolTip="Automatically call Jetway and/or Stairs (which ever is available) if not already connected in the Departure Phase.&#x0a;This is checked constantly in the Departure Phase, so disconnected Jetway/Stairs get reconnected (i.e. disconnected Stairs because of a Conflict)!">
                    <TextBlock>(Re-)Connect Jetway and Stairs in <Underline>Departure</Underline> Phase</TextBlock>
                </CheckBox>

                <StackPanel Grid.Column="0" Grid.Row="4" Style="{StaticResource SettingItemPanel}" ToolTip="Remove all Stairs after all Departure Services have finished (so typically after GSX Boarding completed).">
                    <TextBlock Style="{StaticResource TextBlockDefault}">Remove <Italic>Stairs</Italic> when <Underline>Departure Services</Underline> have finished</TextBlock>
                    <ComboBox SelectedValue="{Binding RemoveStairsAfterDepature}" SelectedValuePath="Tag" Margin="8,0,0,0" Style="{StaticResource ComboBoxDefault}">
                        <ComboBoxItem Tag="0">Never</ComboBoxItem>
                        <ComboBoxItem Tag="1">Always</ComboBoxItem>
                        <ComboBoxItem Tag="2">Only Jetway</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <CheckBox Grid.Column="0" Grid.Row="5" IsChecked="{Binding RemoveJetwayStairsOnFinal}" Style="{StaticResource CheckBoxSettingItem}"
                          ToolTip="Remove both Jetway and Stairs as soon as the Final Loadsheet Delay has expired.">
                    <TextBlock>Remove Jetway and Stairs when <Underline>Final Loadsheet</Underline> is transmitted</TextBlock>
                </CheckBox>
                
                <CheckBox Grid.Column="0" Grid.Row="6" IsChecked="{Binding CallJetwayStairsOnArrival}" Style="{StaticResource CheckBoxSettingItem}"
                          ToolTip="Automatically call Jetway and/or Stairs (which ever is available) on Arrival (= Engines off, Beacon off and Brake set).&#x0a;Note: Stairs are (re-)connected during the whole Arrival Phase if this Setting is used with Departure Services during Deboard!">
                    <TextBlock>Connect Jetway and Stairs on <Underline>Arrival</Underline></TextBlock>
                </CheckBox>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
